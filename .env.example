# Copy to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# --- Public (safe to expose to the client) ---

# Local dev: http://localhost:3000
# Production: https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and anon (RLS-gated public) key.
# Find both in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only ---

# Pooled connection (port 6543) — what the app uses at runtime on Vercel serverless.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session-mode direct connection (port 5432) — used by migrations and seed scripts.
DATABASE_URL_DIRECT=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Bypasses RLS. Allowed in exactly two files:
#   src/lib/db/admin.ts
#   src/app/api/onboarding/create-household/route.ts
# Anywhere else is a P0 bug.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Sentry (Phase 1 errors only)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
