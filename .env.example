# Copy to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# --- Public (safe to expose to the client) ---

# Local dev: http://localhost:3000
# Production: https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and anon (RLS-gated public) key.
# Find both in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only ---

# Runtime connection (port 6543), RLS-enforced. MUST be the non-owner
# `app_runtime` role (LOGIN, NOBYPASSRLS, not the table owner). RLS is ENABLE
# (not FORCE), so pointing this at `postgres` — which owns the tables AND has
# BYPASSRLS — silently disables every policy. Create the role once with:
#   CREATE ROLE app_runtime LOGIN PASSWORD '<pw>';
#   GRANT USAGE ON SCHEMA public TO app_runtime;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_runtime;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO app_runtime;
#   GRANT EXECUTE ON FUNCTION public.current_user_id(), public.current_user_households() TO app_runtime;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_runtime;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO app_runtime;
DATABASE_URL=postgres://app_runtime.<project-ref>:<app-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session-mode direct connection (port 5432), `postgres` role — migrations + seed only.
DATABASE_URL_DIRECT=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Onboarding admin bypass ONLY (src/lib/db/admin.ts): `postgres` @ 6543. The only
# role that can `SET LOCAL ROLE service_role` for the pre-session insert.
DATABASE_URL_ADMIN=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Bypasses RLS. Allowed in exactly two files:
#   src/lib/db/admin.ts
#   src/app/api/onboarding/create-household/route.ts
# Anywhere else is a P0 bug.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project JWT secret — used ONLY by /api/realtime-token to mint
# short-lived (5 min), household-scoped Realtime JWTs (jose / HS256) so the
# browser can open an authenticated Realtime socket WITHOUT any server key.
# This is a DISTINCT secret from SUPABASE_SERVICE_ROLE_KEY (it does NOT
# bypass RLS); keeping it separate is exactly why the realtime-token route
# is NOT a third service-role file (CLAUDE.md §8). Find it at Supabase
# Dashboard → Project Settings → API → JWT Settings → JWT secret. If unset,
# Realtime is simply disabled (devices stop auto-refreshing) and the route
# returns a clean 500 with a fix_suggestion log line.
SUPABASE_JWT_SECRET=

# Integration test database (Phase 2 Task 1 harness — `pnpm test:integration`).
# OPTIONAL. If set, this is the non-owner `app_runtime` connection the
# RLS-isolation gate runs against; pair it with DATABASE_URL_ADMIN_TEST (the
# `postgres` owner conn used ONLY for fixture setup/teardown). Prefer a
# dedicated throwaway database — the suite TRUNCATEs all app tables between
# tests and is destructive. If UNSET, the harness falls back to the dev
# DATABASE_URL (appDb) + DATABASE_URL_ADMIN (adminDb) from this same file.
# `pnpm test` (unit) never touches a database; only `test:integration` does.
DATABASE_URL_TEST=
DATABASE_URL_ADMIN_TEST=

# Optional — Sentry (Phase 1 errors only)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Optional — Anthropic API key for the /import "read any format" feature.
# When set, pasted notes are sent to Claude (Haiku 4.5) to normalize free-form
# text into structured feeds/diapers. When ABSENT, /import falls back to the
# built-in rule parser (textual-month dates only). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
